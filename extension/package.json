{
  "name": "betterw4",
  "description": "Better styling and improved functionality for W4 at UWC Red Cross Nordic",
  "private": true,
  "version": "0.0.1",
  "author": "Jonathan Bangert",
  "homepage": "https://github.com/jonbng/betterw4",
  "repository": {
