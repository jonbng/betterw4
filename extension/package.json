    "url": "https://github.com/jonbng/betterw4/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:safari": "wxt -b safari --mv3",
