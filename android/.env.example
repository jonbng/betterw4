# PostHog Android configuration. Copy to .env and set real values locally.
POSTHOG_PROJECT_TOKEN=your_posthog_project_token
POSTHOG_HOST=https://your-posthog-host

# Required by the PostHog CLI when uploading R8 mappings in CI.
# The CLI host does not include the ingestion subdomain (for example https://eu.posthog.com).
POSTHOG_CLI_HOST=https://your-posthog-region.posthog.com
POSTHOG_CLI_PROJECT_ID=your_posthog_project_id
POSTHOG_CLI_API_KEY=your_personal_api_key
