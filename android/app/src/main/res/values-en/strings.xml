    <string name="settings_privacy_stores">What BetterW4 stores</string>
    <string name="settings_privacy_stores_hint">Session cookie, cached pages, settings, and custom events on this device.</string>
    <string name="settings_privacy_intro">BetterW4 has no servers and no account of its own. Everything it knows lives on this device.</string>
    <string name="settings_privacy_on_device">On this device</string>
    <string name="settings_privacy_session_title">Your W4 session</string>
    <string name="settings_privacy_session_detail">The W4 session cookie and a device identifier are stored on this device. Your password is never saved.</string>
    <string name="settings_privacy_cache_title">Cached W4 pages</string>
    <string name="settings_privacy_cache_detail">Timetable, mail, assessments, attendance and directory pages are cached so the app works offline. Clear cache removes all of it.</string>
    <string name="settings_privacy_settings_title">Your settings</string>
    <string name="settings_privacy_settings_detail">Theme, calendar style, subject names and colours, notification choices, and custom timetable events.</string>
    <string name="settings_privacy_custom_events_title">Custom events</string>
    <string name="settings_privacy_custom_events_detail">Events you add to the timetable stay on this device, one list per account. They are never sent to W4. Logging out does not delete them.</string>
    <string name="settings_privacy_never">Never</string>
    <string name="settings_privacy_analytics_title">No analytics</string>
    <string name="settings_privacy_analytics_detail">No tracking, no crash reporting to a third party, no advertising identifiers.</string>
    <string name="settings_privacy_third_parties_title">No third parties</string>
    <string name="settings_privacy_third_parties_detail">The app talks to w4.uwcrcn.no. If you turn on the school calendar, it also fetches the public college calendar from Google. Your data is never uploaded anywhere.</string>
    <string name="settings_privacy_logout_note">Logging out removes the session and every cached page for that account, so the next person to use this device cannot read them. Custom timetable events stay on the device, scoped to each account.</string>
